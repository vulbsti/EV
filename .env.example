# EV reads this file each time it starts. Only OPENCODE_API is needed to begin.
# All settings: docs/configuration.md

# Key for OpenCode Go (https://opencode.ai), which EV uses for models today.
OPENCODE_API=

# The model EV and its agents use, as provider/model.
# EV_MODEL=opencode-go/gpt-6-luna

# The port of the local page (it only ever listens on this machine).
# EV_PORT=4317
