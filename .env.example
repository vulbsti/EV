# KenWise reads this file each time it starts. Only OPENCODE_API is needed to begin.
# All settings: docs/configuration.md

# Key for OpenCode Go (https://opencode.ai), which KenWise uses for models today.
OPENCODE_API=

# The model KenWise and its agents use, as provider/model.
# EV_MODEL=opencode-go/gpt-6-luna

# A small, cheap model for filing each message into a thread of work.
# EV_MODEL_FILER=opencode-go/claude-haiku-5-5

# How often the threads of work are organised (0 turns the timer off).
# EV_REGROUP_EVERY=7d

# The model that writes how KenWise understands you, and the most often it may rewrite it.
# EV_MODEL_PORTRAIT=
# EV_PORTRAIT_EVERY=1d

# The port of the local page (it only ever listens on this machine).
# EV_PORT=4317
