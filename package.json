{
  "name": "kenwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KenWise: a personal AI assistant that understands you, keeps everything organised in one place, has context across everything without bloat, and remembers like a person, not a list of facts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulbsti/KenWise.git"
  },
  "scripts": {
    "test": "node --test apps/daemon/tests/*.test.mjs",
    "start": "node apps/daemon/server.mjs",
    "openclaw:image": "docker build -t ev-openclaw docker/openclaw",
    "verify": "node verify/run.mjs",
    "qa": "node scripts/run-qa-scenarios.mjs",
    "qa:arc": "node scripts/run-qa-arc.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2"
  },
  "keywords": [
    "personal-assistant",
    "ai-assistant",
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "theory-of-mind",
    "intent",
    "long-term-memory",
    "personal-memory",
    "context-engineering",
    "local-first",
    "self-hosted",
    "openclaw"
  ]
}
